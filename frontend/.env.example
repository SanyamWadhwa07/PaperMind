# Frontend environment — copy to .env.local only if you need to override it.

# Origin of the PaperMind API: scheme and host, no trailing slash, no /api.
# Leave unset locally (Vite proxies /api to :8000) and under Docker Compose
# (nginx proxies it). Set it when the API lives on another origin, e.g. on
# Vercel under Project → Settings → Environment Variables:
# VITE_API_URL=https://<app>.<env>.<region>.azurecontainerapps.io
VITE_API_URL=
