# Backend environment variables — copy to .env and fill in your values.

# ── Supabase (required) ──────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_KEY=your-service-role-key-here

# ── JWT secret (required — use a long random string) ─────────────────────────
JWT_SECRET_KEY=change-me-to-a-64-char-random-string

# ── App environment ───────────────────────────────────────────────────────────
APP_ENV=development   # set to "production" to enforce hard JWT secret check

# ── LLM backend (defaults to Ollama) ─────────────────────────────────────────
# PAPERMIND_LLM_BACKEND=ollama       # default — run: ollama serve
# PAPERMIND_LLM_MODEL=qwen2.5:3b     # override default model

# Cloud LLM alternatives (no GPU required):
# PAPERMIND_LLM_BACKEND=openai
# OPENAI_API_KEY=sk-...
# PAPERMIND_LLM_MODEL=gpt-4o-mini

# PAPERMIND_LLM_BACKEND=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# PAPERMIND_LLM_MODEL=claude-haiku-4-5-20251001

# PAPERMIND_LLM_BACKEND=xai           # xAI Grok (high-quality reasoning)
# XAI_API_KEY=xai-...
# PAPERMIND_LLM_MODEL=grok-beta

# ── LangGraph summarization engine (core/graph/) ──────────────────────────────
# Map-reduce engine that reads the WHOLE paper + does LLM structured extraction
# (no regex). Enable it (off by default = legacy SummaryAgent):
# PAPERMIND_USE_GRAPH=1
#
# Provider chain for the graph engine. "auto" orders by availability:
#   gemini (if key) -> groq (if key) -> ollama.  A named provider becomes PRIMARY
#   and the others act as automatic fallbacks (on rate-limit / failure).
# PAPERMIND_LLM_PROVIDER=auto          # gemini | groq | ollama | auto
# PAPERMIND_LLM_STRICT=                # =1 to disable fallbacks (single provider)
#
# Gemini — most generous free tier; recommended PRIMARY in production:
# GOOGLE_API_KEY=...                   # free key: https://aistudio.google.com/apikey
# (GEMINI_API_KEY is also accepted)
# GROQ_API_KEY=gsk_...                 # free tier: https://console.groq.com
#
# Per-provider/tier model overrides (smart = synthesis, fast = map/extract):
# PAPERMIND_GEMINI_SMART_MODEL=gemini-2.0-flash
# PAPERMIND_GEMINI_FAST_MODEL=gemini-2.0-flash
# PAPERMIND_GROQ_SMART_MODEL=llama-3.3-70b-versatile
# PAPERMIND_GROQ_FAST_MODEL=llama-3.1-8b-instant
# PAPERMIND_OLLAMA_SMART_MODEL=qwen2.5:7b-instruct-q4_K_M
# PAPERMIND_OLLAMA_FAST_MODEL=qwen2.5:3b
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_NUM_CTX=8192
#
# Free-tier rate-limit controls (Groq is ~6k tokens/min on the free tier):
# PAPERMIND_LLM_CONCURRENCY=2          # max simultaneous LLM calls (avoids bursts)
# PAPERMIND_LLM_MAX_RETRIES=6          # backoff retries to absorb 429s
# PAPERMIND_LLM_RPS=                   # optional hard requests/sec cap, e.g. 1.0

# ── Optional services ─────────────────────────────────────────────────────────
# GITHUB_TOKEN=ghp_...                # optional: raises GitHub API limit 60→5000 req/hr
# PAPERMIND_CONTRADICTION_DETECTION=true  # enable cross-paper contradiction detection (slow)
REDIS_URL=redis://localhost:6379/0
SENTRY_DSN=                         # leave blank to disable error monitoring
